  <step>
    <name>Extract Fact Source</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conn_adventureworks</connection>
    <sql>SELECT
    sod.SalesOrderDetailID AS sales_detail_key,
    soh.SalesOrderID AS sales_order_id,
    CAST(DATE_FORMAT(soh.OrderDate, '%Y%m%d') AS UNSIGNED) AS date_key,
    sod.ProductID AS product_id,
    soh.CustomerID AS customer_id,
    soh.TerritoryID AS territory_id,
    sod.SpecialOfferID AS special_offer_id,
    COALESCE(soh.CurrencyRateID, -1) AS currency_rate_id,
    soh.ShipMethodID AS ship_method_id,
    sod.OrderQty AS order_qty,
    sod.UnitPrice AS unit_price,
    sod.UnitPriceDiscount AS unit_price_discount,
    sod.LineTotal AS line_total
FROM sales_salesorderdetail sod
JOIN sales_salesorderheader soh ON sod.SalesOrderID = soh.SalesOrderID
WHERE soh.OnlineOrderFlag = 1;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
